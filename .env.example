# Copy this file to .env and fill in the values you need.
# See the "Environment variables" section of README.md for what each one
# does and which ones are actually required to boot the app.

# ── Core (required) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/relay"
BETTER_AUTH_SECRET="generate-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"
ENCRYPTION_KEY="generate-a-random-secret-used-to-encrypt-stored-credentials"

# ── OAuth account linking (optional — /credentials page) ───────────────
# Each provider only appears on /credentials once both of its vars are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Billing (optional — Polar) ──────────────────────────────────────────
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SUCCESS_URL="http://localhost:3000/billing?checkout=success"

# ── Error monitoring (optional — Sentry source map upload at build time) ─
SENTRY_AUTH_TOKEN=

# NOTE: AI provider API keys (OpenAI, Anthropic, Gemini, Groq, DeepSeek,
# Mistral, Moonshot, Ollama) are NOT set here. Each user adds their own key
# from the /credentials page at runtime; it's encrypted at rest with
# ENCRYPTION_KEY and looked up per-workflow-run. There is nothing to
# configure in .env for AI nodes to work.
